/* Power menu — Windows10 (esquinas rectas, acento azul) */

@import "~/.config/rofi/styles/_core/palette.rasi"

* {
    font: "Noto Sans 18";
    background-color: transparent;
    color: @foreground;
}

window {
    location: center;
    background-color: @background;
    border: 2px;
    border-radius: 0px;
    border-color: @selected;
    padding: 16px;
}

inputbar {
    enabled: false;
}

listview {
    columns: 5;
    lines: 1;
    spacing: 16px;
    scrollbar: false;
}

element {
    min-width: 64px;
    min-height: 64px;
    padding: 8px;
    border-radius: 0px;
}

element selected {
    background-color: @selected;
}

element-text {
    font: "Noto Sans 22";
    horizontal-align: 0.5;
    vertical-align: 0.5;
    min-width: 30px;
    color: inherit;
}
